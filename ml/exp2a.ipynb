import numpy as np
import matplotlib.pyplot as plt

# 1. Dataset
np.random.seed(42)

X = np.arange(1, 21, dtype=float)

# Actual relationship: Y ≈ 2X + 1
# Add random noise
noise = np.random.normal(0, 2, size=len(X))
Y = 2 * X + 1 + noise

# 2. Plot the data
plt.scatter(X, Y)

plt.xlabel("X")
plt.ylabel("Y")
plt.title("Original Data with Noise")

plt.show()
w = 0.0
b = 0.0

learning_rate = 0.001
iterations = 1000

cost_history = []

n = len(X)

for i in range(iterations):

    Y_pred = w * X + b

    cost = np.mean((Y_pred - Y) ** 2)
    cost_history.append(cost)

    dw = (2 / n) * np.sum((Y_pred - Y) * X)
    db = (2 / n) * np.sum(Y_pred - Y)
    w = w - learning_rate * dw
    b = b - learning_rate * db
print("Optimized weight:", w)
print("Optimized bias:", b)
plt.scatter(X, Y, label="Data")
Y_fit = w * X + b
plt.plot(X, Y_fit, label="Gradient Descent Fit")
plt.xlabel("X")
plt.ylabel("Y")
plt.title("Best Fit Line")
plt.legend()
plt.show()
